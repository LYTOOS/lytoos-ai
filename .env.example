# === Lytoos AI - copy to .env.local (local) / Vercel Environment Variables ===
# Supabase (gratis di supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Master key untuk enkripsi provider keys di Supabase (random 32+ char)
LYTOOS_ENCRYPTION_SECRET=change-me-random-32-char-secret

# Mode demo tanpa upstream key: 1 = jawab simulasi, user bisa coba UI & fallback
LYTOOS_DEMO_MODE=1

# === BYOK - Provider Keys GRATIS (isi yang kamu punya saja, semua opsional) ===
# Google AI Studio (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
# DeepSeek (free tier / trial): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Moonshot Kimi (free tier): https://platform.moonshot.ai
KIMI_API_KEY=
MOONSHOT_API_KEY=
# OpenAI-compatible untuk ChatGPT-6 Astra gateway (opsional, BYOK user)
OPENAI_API_KEY=
# Agnes AI (gratis, daftar di dashboard Agnes): https://agnes.ai
AGNES_API_KEY=
# Meta Muse Spark (free via Lytoos demo / Meta AI gateway, BYOK)
MUSE_API_KEY=
META_API_KEY=
# ByteDance Seedance (video, BYOK): https://www.volcengine.com / BytePlus
SEEDANCE_API_KEY=
ARK_API_KEY=

# Base URL override (OpenAI-compatible endpoints)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1
AGNES_BASE_URL=https://api.agnes-ai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
MUSE_BASE_URL=https://api.meta.ai/v1
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
